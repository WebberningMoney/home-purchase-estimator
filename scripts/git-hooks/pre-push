#!/bin/sh
# push 前最後一道檢查：要推上去的 commit 只要有「作者或提交者是 AI 助理預設身分」「不是擁有者」或「帶簽章」，就拒絕推送
z=0000000000000000000000000000000000000000
owner="$(git config estimator.owneremail || true)"
while read lref lsha rref rsha; do
  [ "$lsha" = "$z" ] && continue
  if [ "$rsha" = "$z" ] || ! git cat-file -e "$rsha" 2>/dev/null; then range="$lsha"; else range="$rsha..$lsha"; fi
  for c in $(git rev-list "$range"); do
    # GitHub 網頁建立的第一筆 commit 由 GitHub 簽章，不在檢查範圍
    [ "$(git log -1 --format=%ce "$c")" = "noreply@github.com" ] && continue
    ae="$(git log -1 --format=%ae "$c")"; ce="$(git log -1 --format=%ce "$c")"
    if [ "$ae" = "noreply@anthropic.com" ] || [ "$ce" = "noreply@anthropic.com" ]; then
      echo "❌ commit $(git rev-parse --short "$c") 的作者或提交者是 AI 助理預設身分，已拒絕推送。" >&2; exit 1; fi
    if [ -n "$owner" ] && { [ "$ae" != "$owner" ] || [ "$ce" != "$owner" ]; }; then
      echo "❌ commit $(git rev-parse --short "$c") 的作者或提交者不是專案擁有者，已拒絕推送。" >&2; exit 1; fi
    if git cat-file -p "$c" | sed '/^$/q' | grep -q '^gpgsig'; then
      echo "❌ commit $(git rev-parse --short "$c") 帶有簽章（GitHub 會顯示 Unverified），已拒絕推送。請關閉 commit.gpgsign 後重建這個 commit。" >&2; exit 1; fi
  done
done
